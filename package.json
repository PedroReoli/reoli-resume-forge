{
  "name": "reoli-resume-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" vite.config.ts eslint.config.js \"scripts/**/*.mjs\" --max-warnings 0",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ops": "node --test scripts/ops/*.test.mjs",
    "ops": "node scripts/ops.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:portable": "npm run build && tauri build --no-bundle && node scripts/package-portable.mjs",
    "verify": "npm run lint && npm run build && npm run test:ops && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "framer-motion": "^13.5.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
